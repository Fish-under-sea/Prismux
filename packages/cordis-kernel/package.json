{
  "name": "@prismux/cordis-kernel",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Reversible Cordis-inspired dual-realm plugin kernel and scriptless streaming installer for Prismux.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@prismux/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --customConditions @prismux/source",
    "build": "tsc --rootDir src",
    "test": "node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "@prismux/protocol": "workspace:*"
  }
}
