{
  "name": "@prismux/sync-vault",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "description": "Passphrase-sealed AEAD multi-device encrypted sync engine (WebDAV / S3 / GitHub / Portable) for Prismux.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@prismux/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --customConditions @prismux/source",
    "build": "tsc --rootDir src",
    "test": "node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "@prismux/protocol": "workspace:*"
  }
}
