{
  "name": "@prismux/memory-core",
  "version": "0.2.4-rc.4",
  "private": true,
  "type": "module",
  "description": "Single-file SQLite WAL + FTS5 + sqlite-vec hybrid memory engine and physical scope guard for Prismux.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@prismux/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collector": {
      "@prismux/source": "./src/CollectorAndGuard.ts",
      "types": "./dist/CollectorAndGuard.d.ts",
      "import": "./dist/CollectorAndGuard.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --customConditions @prismux/source",
    "build": "tsc --rootDir src",
    "test": "node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "@prismux/protocol": "workspace:*",
    "sqlite-vec": "^0.1.9"
  }
}
