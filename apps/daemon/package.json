{
  "name": "@prismux/daemon",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "24h headless supervisor daemon hosting t3code server bridge, Chief Supervisor slot, hook bus, PTY pool, sandbox, and overnight factory.",
  "bin": {
    "prismux": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --customConditions @prismux/source",
    "build": "tsc --rootDir src",
    "start": "node dist/cli.js start",
    "test": "node --test dist/__tests__/*.test.js"
  },
  "dependencies": {
    "@prismux/protocol": "workspace:*",
    "@prismux/cordis-kernel": "workspace:*",
    "@prismux/memory-core": "workspace:*",
    "@prismux/sync-vault": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0"
  }
}
