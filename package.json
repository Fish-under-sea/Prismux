{
  "name": "prismux-monorepo",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "test:scripts": "node --test scripts/__tests__/scripts.test.ts",
    "upstream:check": "node scripts/sync-t3-upstream.ts --check",
    "upstream:sync": "node scripts/sync-t3-upstream.ts --sync",
    "brand:rename": "node scripts/rename-brand.ts",
    "plugin:pack": "node scripts/pack-plugin.ts",
    "release:build": "node scripts/release-all.ts",
    "desktop:build": "node scripts/build-prismux-desktop.ts",
    "desktop:installer": "node scripts/build-prismux-desktop.ts --installer"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^24.0.0"
  }
}
